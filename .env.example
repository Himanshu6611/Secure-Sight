# Copy to .env. Never commit real credentials.
APP_ENV=development
# Required in production: generate with secrets.token_hex(32).
FLASK_SECRET_KEY=
SITE_URL=http://localhost:5000
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Empty means same-origin only; comma-separated explicit origins, never *.
ALLOWED_ORIGINS=
LOG_LEVEL=INFO
SCAN_RATE_LIMIT=20 per minute
# Additional authenticated account/token limit per detector endpoint.
ACTOR_SCAN_RATE_LIMIT=10 per minute
MAX_CONCURRENT_SCANS=2
# memory:// is development-only. Production requires reachable shared Redis.
RATELIMIT_STORAGE_URI=memory://
# Never download model artifacts during scans. CLIP is not a deepfake model.
HF_HUB_OFFLINE=1
# Optional trusted local OCR executable (default resolves system Tesseract).
TESSERACT_CMD=
# Optional operator-provisioned C2PA PEM trust anchors; never supplied by uploads.
C2PA_TRUST_ANCHORS_FILE=

# Phase 12: production private dashboard is disabled until both are set.
# Use a durable private path and an independently generated secret (32+ characters).
# DASHBOARD_DB_PATH=/var/lib/securesight/dashboard.sqlite3
# DASHBOARD_ENCRYPTION_KEY=

# Keep disabled until the confirmed HTTPS public origin and release readiness are verified.
SEO_INDEXING_ENABLED=false
